generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum UserRole { ADMIN }
enum ArticleStatus { DRAFT PUBLISHED }
enum DonationStatus { PENDING CONTACTED CONFIRMED RECEIVED CANCELLED }
enum ContactRequestStatus { PENDING CONTACTED RESOLVED CANCELLED }
enum ContactRequestType { DONATION FORAGE FOOD_SUPPORT VOLUNTEERING MATERIAL_SUPPORT GENERAL }

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  passwordHash String
  firstName String?
  lastName String?
  role UserRole @default(ADMIN)
  isActive Boolean @default(true)
  refreshTokenHash String?
  refreshTokenJti String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLoginAt DateTime?
}
model Category {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  slug String @unique
  description String?
  articles Article[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Article {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  title String
  excerpt String @db.Text
  content String @db.Text
  coverImage String
  imageAlt String
  status ArticleStatus @default(DRAFT)
  isFeatured Boolean @default(false)
  author String
  readingTimeMinutes Int @default(1)
  viewsCount Int @default(0)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  categoryId String @db.Uuid
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  viewEvents ArticleView[]
  @@index([status, publishedAt])
  @@index([categoryId])
}
model ArticleView {
  id String @id @default(uuid()) @db.Uuid
  articleId String @db.Uuid
  visitorHash String
  bucket DateTime
  createdAt DateTime @default(now())
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  @@unique([articleId, visitorHash, bucket])
  @@index([createdAt])
}
model Donation {
  id String @id @default(uuid()) @db.Uuid
  donorName String
  donorContact String
  donorEmail String?
  type String
  amount Decimal? @db.Decimal(12, 2)
  currency String @default("XOF")
  message String? @db.Text
  status DonationStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([type])
}
model ContactRequest {
  id String @id @default(uuid()) @db.Uuid
  name String
  phone String
  email String?
  type ContactRequestType @default(GENERAL)
  message String? @db.Text
  status ContactRequestStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([type])
}
